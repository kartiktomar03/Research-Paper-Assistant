# Required for AI summaries and answers
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile

# Optional: set this to a Groq-supported vision model to describe extracted figures
# If unset, figure images and captions are still extracted, but not AI-described.
# Verify current model availability in your Groq account before using.
GROQ_VISION_MODEL=

# Vector storage: choose ONE mode. Leave QDRANT_URL empty for embedded local Qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=research_paper_chunks
QDRANT_LOCAL_PATH=./data/qdrant

# Must match embedding model dimensions (all-MiniLM-L6-v2 outputs 384)
# Optional for local use: sentence-transformers (default). Docker uses fastembed automatically.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RETRIEVAL_SCORE_THRESHOLD=0.22
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
PORT=5000
